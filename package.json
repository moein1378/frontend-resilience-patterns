{
  "name": "frontend-resilience-patterns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @frp/lab dev",
    "dev:all": "concurrently -k -n api,lab -c cyan,orange \"pnpm --filter @frp/chaos-api dev\" \"pnpm --filter @frp/lab dev\"",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "codegen": "node scripts/codegen.mjs",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "lint": "eslint scripts packages apps/chaos-api tests --max-warnings 0 && pnpm --filter @frp/lab lint:check",
    "architecture:check": "node scripts/check-architecture.mjs && vitest run scripts/check-architecture.test.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @frp/lab typecheck",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @frp/chaos-api build && pnpm --filter @frp/lab build",
    "build:demo": "DEMO_BASE=/frontend-resilience-patterns/ pnpm --filter @frp/lab build",
    "verify": "pnpm format:check && pnpm lint && pnpm architecture:check && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
