{
  "name": "@frp/lab",
  "version": "0.1.0",
  "description": "Deterministic frontend resilience laboratory",
  "productName": "Frontend Resilience Patterns",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" && prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@frp/contracts": "workspace:*",
    "@frp/failure-scenarios": "workspace:*",
    "@frp/resilience-core": "workspace:*",
    "@frp/telemetry": "workspace:*",
    "@quasar/extras": "2.1.0",
    "quasar": "2.35.2",
    "vue": "3.5.44",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@quasar/app-vite": "3.10.3",
    "@types/node": "24.19.2",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.4.27",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "postcss": "8.5.8",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "vite-plugin-checker": "0.14.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
